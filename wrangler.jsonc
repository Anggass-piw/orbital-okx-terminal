{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbital-okx-terminal",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ORBITAL_ORDER_GUARD",
        "class_name": "OrderGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrderGuard"]
    }
  ]
}
